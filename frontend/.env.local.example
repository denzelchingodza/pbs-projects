NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Google reCAPTCHA v2 Site Key (from google.com/recaptcha/admin, register
# both localhost and the real domain). Leave empty and the "I'm not a
# robot" checkbox on the quote form doesn't render at all, submissions
# still work as before, this is what local dev does by default. The
# matching Secret Key goes in backend/.env as RECAPTCHA_SECRET_KEY instead.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
