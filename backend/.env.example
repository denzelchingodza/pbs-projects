# Local dev (default, no setup needed):
DATABASE_URL=sqlite:///./pbs_projects.db
# Production (Postgres) — requires: pip install -r requirements-postgres.txt
# DATABASE_URL=postgresql+psycopg://pbs_user:pbs_pass@localhost:5432/pbs_projects
SECRET_KEY=change-this-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CLOUDINARY_URL=
# Get a real Site Key + Secret Key at google.com/recaptcha/admin (v2 "I'm
# not a robot" checkbox, register both localhost and the real domain).
# Leave empty and quote form submissions skip reCAPTCHA entirely, this is
# what local dev does by default. The Site Key is the frontend's, set as
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY in frontend/.env.local instead.
RECAPTCHA_SECRET_KEY=
